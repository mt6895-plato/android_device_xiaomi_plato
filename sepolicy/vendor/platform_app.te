get_prop(platform_app_36, vendor_fingerprint_prop)
binder_call(platform_app_36, hal_fingerprint_default)

allow platform_app_36 fingerprint_vendor_data_file:file r_file_perms;
allow platform_app_36 vendor_hal_fingerprint_hwservice_xiaomi:hwservice_manager find;   

# Camera Post Processing
type vendor_hal_camera_campostproc_hwservice_xiaomi, hwservice_manager_type;
allow platform_app_36 vendor_hal_camera_campostproc_hwservice_xiaomi:hwservice_manager find;
neverallow { untrusted_app isolated_app } vendor_hal_camera_campostproc_hwservice_xiaomi:hwservice_manager { find };